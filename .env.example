# ============================================
# Sanity CMS (preferred — used in production)
# ============================================
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read token (optional — only needed for drafts/private datasets)
SANITY_API_TOKEN=

# ============================================
# Required in production — the newsletter needs it
# The /api/subscribe function (Netlify + Vercel) reads
# this at runtime to create subscriber documents.
# Without it every signup returns 500.
# Generate at: sanity.io/manage → API → Tokens → Add API token
# Permissions: "Editor" or higher
# Set it in the host's env vars, never in the repo.
# ============================================

# ============================================
# Studio dev (used by Sanity CLI in studio/)
# ============================================
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# ============================================
# Google Sheets (legacy — unset once migrated)
# ============================================
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
